# ===================================================
# AUREON RECONCILIATION PLATFORM - ENVIRONMENT CONFIG
# ===================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ---------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------
ENVIRONMENT=development          # development | staging | production
APP_NAME=Aureon Reconciliation
APP_VERSION=2.0.0
WORKERS=1                        # Increase to 4+ for production

# ---------------------------------------------------
# DATABASE
# ---------------------------------------------------
DATABASE_URL=postgresql://aureon:aureon123@localhost:5432/custody_ai

# ---------------------------------------------------
# REDIS (Optional - for caching)
# ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------
# AUTHENTICATION (Clerk)
# ---------------------------------------------------
CLERK_PEM_PUBLIC_KEY=your_clerk_public_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ---------------------------------------------------
# AI SERVICES
# ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# ---------------------------------------------------
# CORS SETTINGS
# ---------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------
# FEATURE FLAGS
# ---------------------------------------------------
ENABLE_AI_RESOLVE=true
ENABLE_PDF_PARSING=true
MAX_UPLOAD_SIZE_MB=50
